[
  {
    "type": "record",
    "name": "RunStarted",
    "namespace": "arca.bench",
    "doc": "Emitted when a test run starts.",
    "fields": [
      { "name": "run_id", "type": "string" },
      { "name": "target", "type": "string" },
      { "name": "started_at", "type": "string" }
    ]
  },
  {
    "type": "record",
    "name": "RunCompleted",
    "namespace": "arca.bench",
    "doc": "Emitted when a test run completes.",
    "fields": [
      { "name": "run_id", "type": "string" },
      { "name": "status", "type": "string" },
      { "name": "passed_count", "type": "int" },
      { "name": "failed_count", "type": "int" },
      { "name": "completed_at", "type": "string" }
    ]
  },
  {
    "type": "record",
    "name": "ScorePublished",
    "namespace": "arca.bench",
    "doc": "Emitted when a score is computed.",
    "fields": [
      { "name": "score_id", "type": "string" },
      { "name": "run_id", "type": "string" },
      { "name": "target", "type": "string" },
      { "name": "dimension", "type": "string" },
      { "name": "value", "type": "double" }
    ]
  },
  {
    "type": "record",
    "name": "EvidenceCollected",
    "namespace": "arca.bench",
    "doc": "Emitted when evidence is collected.",
    "fields": [
      { "name": "evidence_id", "type": "string" },
      { "name": "run_id", "type": "string" },
      { "name": "artifact_url", "type": "string" },
      { "name": "sha256", "type": "string" },
      { "name": "collected_at", "type": "string" }
    ]
  },
  {
    "type": "record",
    "name": "ReportGenerated",
    "namespace": "arca.bench",
    "doc": "Emitted when a report is generated.",
    "fields": [
      { "name": "report_id", "type": "string" },
      { "name": "run_id", "type": "string" },
      { "name": "format", "type": "string" },
      { "name": "created_at", "type": "string" }
    ]
  },
  {
    "type": "record",
    "name": "AssetPublished",
    "namespace": "arca.bench",
    "doc": "Consumed from the platform to trigger a default suite.",
    "fields": [
      { "name": "asset_id", "type": "string" },
      { "name": "suite", "type": { "type": "array", "items": "string" } },
      { "name": "published_at", "type": "string" }
    ]
  },
  {
    "type": "record",
    "name": "BenchResults",
    "namespace": "arca.bench",
    "doc": "Emitted when a bench run completes with aggregated results.",
    "fields": [
      { "name": "bench_id", "type": "string" },
      { "name": "target", "type": "string" },
      { "name": "dimension", "type": "string" },
      { "name": "passed", "type": "boolean" },
      { "name": "score", "type": "double" },
      {
        "name": "evidence",
        "type": {
          "type": "array",
          "items": {
            "type": "record",
            "name": "EvidenceRef",
            "fields": [
              { "name": "source", "type": "string" },
              { "name": "ref_id", "type": "string" },
              { "name": "description", "type": "string" }
            ]
          }
        }
      }
    ]
  }
]
