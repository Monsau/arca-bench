{
  "module": "arca-bench",
  "version": "2.3.0",
  "governance": "Capabilities are versioned and published through OOC gates (ADR-004, ADR-009).",
  "capabilities": [
    {
      "name": "test-register",
      "description": "Register a new test case in the bench catalog.",
      "input_schema": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "category": { "type": "string" },
          "version": { "type": "string" }
        },
        "required": ["name", "category"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "version": { "type": "string" }
        }
      }
    },
    {
      "name": "run_test_suite",
      "description": "Execute a test suite against a target and return the run summary.",
      "input_schema": {
        "type": "object",
        "properties": {
          "target": { "type": "string" },
          "suite": { "type": "array", "items": { "type": "string" } },
          "collect_evidence": { "type": "boolean" }
        },
        "required": ["target", "suite"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "run_id": { "type": "string" },
          "status": { "type": "string" },
          "summary": { "type": "object" },
          "results": { "type": "array" }
        }
      }
    },
    {
      "name": "get_scorecard",
      "description": "Return the scorecard for a completed test run.",
      "input_schema": {
        "type": "object",
        "properties": {
          "run_id": { "type": "string" }
        },
        "required": ["run_id"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "target": { "type": "string" },
          "dimensions": { "type": "object" },
          "overall": { "type": "number" },
          "run_id": { "type": "string" },
          "generated_at": { "type": "string" }
        }
      }
    },
    {
      "name": "generate_report",
      "description": "Generate a JSON or HTML remediation report for a run.",
      "input_schema": {
        "type": "object",
        "properties": {
          "run_id": { "type": "string" },
          "format": { "type": "string", "enum": ["json", "html"] }
        },
        "required": ["run_id"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "run_id": { "type": "string" },
          "format": { "type": "string" },
          "content": { "type": "string" },
          "created_at": { "type": "string" }
        }
      }
    }
  ]
}
